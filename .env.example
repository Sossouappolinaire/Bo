# ============================================================
#  CONFIGURATION - PLATEFORME TACHES SOCIALES (Render.com)
#  Copiez ces variables dans Render : Environment -> Add Env Var
#  OU creez un fichier .env en local (non envoye sur Git).
#  IMPORTANT : aucune cle ne doit etre ecrite dans le code.
# ============================================================

# Port d'ecoute (Render fournit PORT automatiquement, 10000 en local)
PORT=10000

# URL publique du site une fois deploye (utilisee pour les retours/webhooks MoneyFusion)
PUBLIC_URL=https://votre-app.onrender.com

# Le diagnostic de déploiement est disponible sur /api/health

# Base de donnees PostgreSQL (Render PostgreSQL -> copier "External Database URL")
DATABASE_URL=postgresql://user:password@host:5432/nom_base

# Secret JWT (Render le génère automatiquement via render.yaml)
JWT_SECRET=

# Compte administrateur créé automatiquement au démarrage
ADMIN_EMAIL=sossoukouam@gmail.com
ADMIN_PASSWORD=
# Téléphone facultatif de l'administrateur (compatibilité retraits)
ADMIN_TELEPHONE=

# --- MONEYFUSION (FusionPay) ---
# Lien API de votre application FusionPay (dashboard Money Fusion)
# Exemple : https://api.moneyfusion.net  (collez l'URL exacte de votre app)
MONEYFUSION_API_URL=

# Cle privee pour les DECAISSEMENTS (retraits utilisateurs)
# Dashboard Money Fusion -> Parametres -> generer une cle API
# N'oubliez pas d'ajouter l'IP de votre serveur Render dans le dashboard.
MONEYFUSION_PRIVATE_KEY=

# --- REGLES METIER (modifiables sans toucher au code) ---
# Recompense par tache complete (1 like + 5 commentaires)
TASK_REWARD=3
# Prix par interaction pour le client
PRICE_PER_INTERACTION=1
# Retrait minimum (FCFA)
MIN_WITHDRAWAL=300

# --- ASSISTANT IA (Groq) ---
# Créez la clé dans le tableau de bord Groq puis ajoutez-la
# dans Render > Environment. Ne l'écrivez jamais dans le code front.
GROQ_API_KEY=
# Modèle rapide recommandé (modifiable selon votre compte Groq)
GROQ_MODEL=llama-3.1-8b-instant

# --- CONNEXION SOCIALE (OAuth) ---
# Les URI de rappel sont automatiques avec PUBLIC_URL ou RENDER_EXTERNAL_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# --- E-MAIL DE BIENVENUE (SMTP / Gmail) ---
# Pour Gmail, créez un mot de passe d'application et stockez-le uniquement
# dans Render : SMTP_SERVICE=gmail fonctionne aussi sans SMTP_HOST.
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Adresse affichée dans le champ expéditeur (facultatif ; défaut : SMTP_USER)
MAIL_FROM=

# ------------------------------------------------------------
# RAPPEL RENDER :
# 1. New -> Web Service -> connecter le repo (8 fichiers a la racine)
# 2. Build Command : npm install
# 3. Start Command : npm start
# 4. Addons -> PostgreSQL (copier DATABASE_URL dans les env vars)
# 5. Renseigner toutes les variables ci-dessus
# 6. Le schema de base est cree automatiquement au demarrage.
# 7. Pour activer les e-mails, ajoutez SMTP_USER, SMTP_PASS et MAIL_FROM
#    dans Render. N'écrivez jamais de mot de passe dans le dépôt.
# Point a verifier chez MoneyFusion : que votre compte/API autorise
# bien les paiements entrants ET les decaissements (payout) vers le
# pays et le numero saisis par l'utilisateur.
# ------------------------------------------------------------
