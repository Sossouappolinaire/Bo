# PostgreSQL Render (obligatoire)
DATABASE_URL=postgresql://user:password@host:5432/database

# Sécurité (obligatoire en production)
SESSION_SECRET=remplacez-cette-valeur-par-un-secret-long-et-aleatoire

# Premier compte administrateur et notifications
ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=
EMAIL_FROM=KoraBoost <noreply@example.com>

# URL publique utilisée par les callbacks SebPay
PUBLIC_URL=https://votre-service.onrender.com
SEBPAY_BASE_URL=https://newapi.sebpay.bj

# Paramètres métier facultatifs
TASK_REWARD=3
PRICE_PER_INTERACTION=1
MIN_WITHDRAWAL=300